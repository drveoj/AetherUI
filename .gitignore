# WoW writes these next to the addon; they are per-character state, not source.
SavedVariables/
*.lua.bak

# One-time setup script, not part of the addon.
git-setup.sh

# Editor / OS noise
*.bak
*.orig
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# Python scratch from Tools/
__pycache__/
*.pyc
.venv/
venv/

# Commit helper, same as git-setup.sh: a script for you to run, not addon source.
commit-chat.sh
commit-tracker-chip.sh

# Claude Code local settings — machine-specific absolute paths, not source.
.claude/settings.local.json

# The full-size screenshots. Media/ SHIPS - it is where the addon's own textures
# live - so thirty megabytes of PNG in there is thirty megabytes on every
# download. The web-sized copies committed under docs/screenshots/ are what the
# README points at, and docs/ does not ship. Keep the originals here; they are
# just not the repository's business.
Media/Screenshots/

# The plans and the developer notes. They stay on disk and out of the repository.
#
# NOT the whole of docs/ - the README's images live under docs/brand and
# docs/screenshots and have to be tracked or every picture in it is a broken
# link on the repository page. It is the prose that is private: the handoff
# plans and NOTES.md are working notes with local machine paths in them, and
# the source comments that cite them still cite them.
docs/*.md
