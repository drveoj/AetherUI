package-as: AetherUI

# WHAT SHIPS IS WHAT THE CLIENT LOADS, plus the one file a person might read.
#
# The harness alone is thirty thousand lines and the plans and handoff notes are
# most of a megabyte; none of it is any use inside an addon folder. The tools
# stay in the repository, where they belong, and out of the zip.
#
# README.md DOES ship. It is written for somebody who has just installed this
# and is looking at the folder, which is a different audience from every other
# file here - the developer's notes moved to docs/NOTES.md to make room for it.
ignore:
    - Tools
    - docs
    - .claude
    - .github
    # A GUARD, not a description. Media/Screenshots is gone - the web-sized
    # copies under docs/screenshots are the only ones kept - but the line stays,
    # because the failure it prevents was silent and expensive.
    #
    # Anything git ignores is invisible to the packager, which builds from a
    # checkout. Tools/package.py builds from the WORKING TREE, where an ignored
    # folder is sitting right there, so it shipped thirty-eight megabytes of
    # full-size PNG inside the addon and nothing said a word. Ignored-but-present
    # has to be named HERE as well, or the two builders disagree about what a
    # release is.
    - Media/Screenshots

# The libraries are vendored rather than pulled at package time, deliberately.
#
# An `externals` block fetches each one from its own repository as the zip is
# built, which means a release can change because somebody else pushed. What is
# in Libs/ is what has been run against the harness; a library moves when we
# move it, and the commit that moves it says so.
enable-nolib-creation: no

# The packager rewrites @localization@ blocks in Locale/ from the CurseForge
# phrase list as it builds - see Locale/enUS.lua for the whole arrangement.
# Nothing here is needed for that; it is on by default. This file exists to say
# what is in the zip.
