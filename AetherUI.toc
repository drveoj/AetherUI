Modules\Onboard.lua

# The in-flight console. Both route tables are generated by Tools/taxidata.py
# and must load before the lookup that reads them.
#
# ONE PER CLIENT, and both listed here. Cataclysm renamed flight points -
# Era's "Crossroads, The Barrens" is "The Crossroads, Northern Barrens" on
# Mists - and the tables are keyed on the name TaxiNodeName returns, so one
# table cannot serve both. Each file returns at once on the client it is not
# for, which costs a compiled chunk and builds no table. That is cheaper than
# a second .toc: see the note at the top of this file about writing VERSION
# down twice.
Modules\IFEC\Routes.lua
Modules\IFEC\Routes_Mists.lua
Modules\IFEC\Route.lua
Modules\IFEC\Taxi.lua
Modules\IFEC\Console.lua
